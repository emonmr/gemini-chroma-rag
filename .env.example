# ── Gemini (get a free key at https://aistudio.google.com/apikey) ──────────────
GEMINI_API_KEY=

# Model names change often. If you get a 404 / "model not found", open
# Google AI Studio, pick a current free-tier model and paste its code here.
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
# 768 is the recommended small size (also 1536 or 3072). Changing this or the
# embed model creates a NEW Chroma collection, so run `npm run ingest` again.
EMBED_DIMENSIONS=768

# ── Chroma (docker compose up -d) ───────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=docs

# ── RAG knobs (experiment with these!) ──────────────────────────────────────────
DOCS_DIR=./data/docs
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
# Drop retrieved chunks below this cosine similarity (0 = keep everything)
MIN_SCORE=0
